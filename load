local DataStoreService = game:GetService("DataStoreService")
local target = DataStoreService:GetDataStore("__TEST")

task.spawn(function()
    local counter = 0
    local data = "colorful"
    
    while true do
        counter += 1
        local key = "Color_" .. tostring(counter)
        
        task.spawn(function()
            pcall(function() 
                target:SetAsync(key, data) 
            end)
        end)
        
        task.spawn(function()
            pcall(function() 
                target:GetAsync(key) 
            end)
        end)
        
        task.spawn(function()
            pcall(function() 
                target:RemoveAsync(key) 
            end)
        end)
        
        task.wait()
    end
end)
