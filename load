local function parse(input)
	local result = {}
	local current = {}
	local i = 1
	local len = #input

	while i <= len do
		local char = input:sub(i, i)

		if char == "\\" and i < len and input:sub(i + 1, i + 1) == ":" then
			table.insert(current, ":")
			i = i + 2
		elseif char == ":" then
			table.insert(result, table.concat(current))
			current = {}
			i = i + 1
		else
			table.insert(current, char)
			i = i + 1
		end
	end

	table.insert(result, table.concat(current))
	return result
end

